# Chotu provisioning root.
#
# Module design: this file picks exactly one cloud module and every cloud
# module honors the same contract, so adding a provider means adding one
# directory plus one module block below. Nothing else changes.
#
# Module contract:
#   inputs:  name_prefix, region, instance_type, image_id,
#            use_spot, persist, root_disk_size_gb,
#            root_disk_type, status_port, allowed_cidr_blocks,
#            s3_enabled, s3_create_bucket, s3_bucket_name, s3_sync_prefix,
#            s3_sync_interval, s3_exclusions, inference_runtime,
#            inference_model, inference_quantization, inference_access,
#            inference_image, inference_port, inference_max_model_len,
#            inference_gpu_memory_utilization, inference_max_output_tokens,
#            opencode_enabled, tooling_packages, chotu_release_version
#            (SSH keys are generated by each module and written next to the
#            terraform files, never passed in.)
#   outputs: instance_id, public_ip, status_url, ssh, ssh_config_snippet,
#            s3_bucket, ssh_key_file
#
# Flow inside every module: one machine -> cloud-init writes
# /etc/chotu/config.yaml -> the release bootstrap starts both daemons ->
# the status page comes up on status_port while chotu-setup converges
# the machine.

terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "aws" {
  region = var.region
}

provider "google" {
  project = var.gcp_project
  region  = var.region
}

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------

variable "cloud_provider" {
  type        = string
  default     = "aws"
  description = "Cloud to provision on. Only \"aws\" is implemented; vastai and gcp have stub modules waiting for an implementation."

  validation {
    condition     = contains(["aws"], var.cloud_provider)
    error_message = "Only \"aws\" is implemented yet. To add a provider, implement modules/<name>/ against the contract at the top of this file and extend this list."
  }
}

variable "gcp_project" {
  type        = string
  default     = ""
  description = "GCP project ID. Only used by the gcp module."
}

# ---------------------------------------------------------------------------
# Common inputs, passed straight through to the active cloud module.
# Defaults mirror the dev config (dev.config.yaml).
# ---------------------------------------------------------------------------

variable "name_prefix" {
  type        = string
  default     = "chotu"
  description = "Prefix for all resource names and tags."
}

variable "region" {
  type        = string
  default     = "us-west-2"
  description = "Cloud region. Each module maps it to its own geography."
}

variable "instance_type" {
  type        = string
  default     = "g6.xlarge"
  description = "Machine shape. Each module maps it to its own machine types."
}

variable "image_id" {
  type        = string
  default     = ""
  description = "Machine image to boot. Empty means the module's default (Ubuntu 26.04)."
}

variable "use_spot" {
  type        = bool
  default     = false
  description = "Use spare/preemptible capacity. Must pair with persist=false."
}

variable "persist" {
  type        = bool
  default     = true
  description = "Persistent topology: workspace and Docker root live on the root disk. False keeps everything on ephemeral storage (spot only)."
}

variable "root_disk_size_gb" {
  type        = number
  default     = 80
  description = "Root disk size in GiB."
}

variable "root_disk_type" {
  type        = string
  default     = "gp2"
  description = "Root disk type. Each module maps it to its own disk types."
}

variable "status_port" {
  type        = number
  default     = 8081
  description = "Port of the status page. Must match status_page.port in the rendered config."
}

variable "allowed_cidr_blocks" {
  type        = list(string)
  default     = ["0.0.0.0/0"]
  description = "CIDR blocks allowed to reach SSH and the status page. Narrow this to your IP for a non-demo machine."
}

variable "s3_enabled" {
  type        = bool
  default     = true
  description = "Enable workspace sync to S3."
}

variable "s3_bucket_name" {
  type        = string
  default     = "chotu-workspace-324330563475-us-west-2"
  description = "Workspace bucket. Lowercase, globally unique; the instance role is scoped to it."
}

variable "s3_create_bucket" {
  type        = bool
  default     = true
  description = "Create the workspace bucket. False adopts the existing bucket. Flip to false when pointing at a bucket that already holds data."
}

variable "s3_sync_prefix" {
  type        = string
  default     = "workspace"
  description = "Key prefix for workspace sync."
}

variable "s3_sync_interval" {
  type        = string
  default     = "1m"
  description = "Sync interval."
}

variable "s3_exclusions" {
  type        = list(string)
  default     = [".git/**", "node_modules/**", ".venv/**", "__pycache__/**", ".cache/**"]
  description = "Additional sync exclusions."
}

variable "inference_runtime" {
  type        = string
  default     = "vllm"
  description = "Inference runtime."
}

variable "inference_model" {
  type        = string
  default     = "cyankiwi/Qwen3-Coder-30B-A3B-Instruct-AWQ-4bit"
  description = "Model to serve."
}

variable "inference_quantization" {
  type        = string
  default     = "awq"
  description = "Model quantization."
}

variable "inference_access" {
  type        = string
  default     = "local"
  description = "Endpoint exposure. Local means SSH tunnel, not public."
}

variable "inference_image" {
  type        = string
  default     = "vllm/vllm-openai:v0.30.0-x86_64@sha256:5f5e535216848d0c52159c8c13a0af04be5f6fe1a84e79914300610796f76d40"
  description = "Pinned inference image (tag + digest)."
}

variable "inference_port" {
  type        = number
  default     = 8000
  description = "Local inference endpoint port."
}

variable "inference_max_model_len" {
  type        = number
  default     = 14336
  description = "Mirrors inference.resources.max_model_len."
}

variable "inference_gpu_memory_utilization" {
  type        = number
  default     = 0.97
  description = "Mirrors inference.resources.gpu_memory_utilization."
}

variable "inference_max_output_tokens" {
  type        = number
  default     = 4096
  description = "Mirrors inference.resources.max_output_tokens."
}

variable "opencode_enabled" {
  type        = bool
  default     = true
  description = "Run OpenCode on the machine."
}

variable "tooling_packages" {
  type        = list(string)
  default     = ["git", "tmux", "htop", "nvtop", "python3.14", "golang-go"]
  description = "Extra packages installed on the machine."
}

variable "chotu_release_version" {
  type        = string
  default     = "v0.1.0"
  description = "Chotu GitHub release tag. The machine fetches bootstrap.sh from this tag, and bootstrap downloads the daemon binaries from the same release."
}

# ---------------------------------------------------------------------------
# Cloud modules. Exactly one is active; the rest have count 0.
#
# Adding a provider: implement modules/<name>/ against the contract at the
# top of this file, then add a gated block here plus outputs below.
# ---------------------------------------------------------------------------

module "aws" {
  source = "./modules/aws"
  count  = var.cloud_provider == "aws" ? 1 : 0

  name_prefix                      = var.name_prefix
  region                           = var.region
  instance_type                    = var.instance_type
  image_id                         = var.image_id
  use_spot                         = var.use_spot
  persist                          = var.persist
  root_disk_size_gb                = var.root_disk_size_gb
  root_disk_type                   = var.root_disk_type
  status_port                      = var.status_port
  allowed_cidr_blocks              = var.allowed_cidr_blocks
  s3_enabled                       = var.s3_enabled
  s3_create_bucket                 = var.s3_create_bucket
  s3_bucket_name                   = var.s3_bucket_name
  s3_sync_prefix                   = var.s3_sync_prefix
  s3_sync_interval                 = var.s3_sync_interval
  s3_exclusions                    = var.s3_exclusions
  inference_runtime                = var.inference_runtime
  inference_model                  = var.inference_model
  inference_quantization           = var.inference_quantization
  inference_access                 = var.inference_access
  inference_image                  = var.inference_image
  inference_port                   = var.inference_port
  inference_max_model_len          = var.inference_max_model_len
  inference_gpu_memory_utilization = var.inference_gpu_memory_utilization
  inference_max_output_tokens      = var.inference_max_output_tokens
  opencode_enabled                 = var.opencode_enabled
  tooling_packages                 = var.tooling_packages
  chotu_release_version            = var.chotu_release_version
}

# ---------------------------------------------------------------------------
# Outputs delegate to whichever module is active.
# ---------------------------------------------------------------------------

output "instance_id" {
  value       = var.cloud_provider == "aws" ? module.aws[0].instance_id : null
  description = "Machine ID of the Chotu machine."
}

output "public_ip" {
  value       = var.cloud_provider == "aws" ? module.aws[0].public_ip : null
  description = "Public IP of the Chotu machine."
}

output "status_url" {
  value       = var.cloud_provider == "aws" ? module.aws[0].status_url : null
  description = "Status page: setup progress and system resources while the machine converges."
}

output "ssh" {
  value       = var.cloud_provider == "aws" ? module.aws[0].ssh : null
  description = "SSH command with the generated key and tunnels."
}

output "ssh_config_snippet" {
  value       = var.cloud_provider == "aws" ? module.aws[0].ssh_config_snippet : null
  description = "Paste into ~/.ssh/config for plain `ssh chotu` with tunnels."
}

output "s3_bucket" {
  value       = var.cloud_provider == "aws" ? module.aws[0].s3_bucket : null
  description = "Workspace bucket in use (created or adopted)."
}
