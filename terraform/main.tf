# Chotu provisioning root.
#
# Module design: this file picks exactly one cloud module and every cloud
# module honors the same contract, so adding a provider means adding one
# directory plus one module block below. Nothing else changes.
#
# Module contract:
#   inputs:  name_prefix, region, instance_type, image_id,
#            use_spot, persist, root_disk_size_gb,
#            root_disk_type, status_port, allowed_cidr_blocks,
#            s3_enabled, s3_create_bucket, s3_bucket_name, s3_sync_prefix,
#            s3_sync_interval, s3_exclusions, inference_runtime,
#            inference_model, inference_quantization, inference_access,
#            inference_image, inference_port, inference_max_model_len,
#            inference_gpu_memory_utilization, inference_max_output_tokens,
#            opencode_enabled, tooling_packages, chotu_release_version
#            (SSH keys are generated by each module and written next to the
#            terraform files, never passed in.)
#   outputs: instance_id, public_ip, status_url, ssh, ssh_config_snippet,
#            s3_bucket, ssh_key_file
#
# Flow inside every module: one machine -> cloud-init writes
# /etc/chotu/config.yaml -> the release bootstrap starts both daemons ->
# the status page comes up on status_port while chotu-setup converges
# the machine.

terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "aws" {
  region = var.region
}

provider "google" {
  project = var.gcp_project
  region  = var.region
}

# Inputs live in variables.tf (the control panel); outputs at the bottom.

# ---------------------------------------------------------------------------
# Cloud modules. Exactly one is active; the rest have count 0.
#
# Adding a provider: implement modules/<name>/ against the contract at the
# top of this file, then add a gated block here plus outputs below.
# ---------------------------------------------------------------------------

module "aws" {
  source = "./modules/aws"
  count  = var.cloud_provider == "aws" ? 1 : 0

  name_prefix                      = var.name_prefix
  region                           = var.region
  instance_type                    = var.instance_type
  image_id                         = var.image_id
  use_spot                         = var.use_spot
  persist                          = var.persist
  root_disk_size_gb                = var.root_disk_size_gb
  root_disk_type                   = var.root_disk_type
  status_port                      = var.status_port
  allowed_cidr_blocks              = var.allowed_cidr_blocks
  s3_enabled                       = var.s3_enabled
  s3_create_bucket                 = var.s3_create_bucket
  s3_bucket_name                   = var.s3_bucket_name
  s3_sync_prefix                   = var.s3_sync_prefix
  s3_sync_interval                 = var.s3_sync_interval
  s3_exclusions                    = var.s3_exclusions
  inference_runtime                = var.inference_runtime
  inference_model                  = var.inference_model
  inference_quantization           = var.inference_quantization
  inference_access                 = var.inference_access
  inference_image                  = var.inference_image
  inference_port                   = var.inference_port
  inference_max_model_len          = var.inference_max_model_len
  inference_gpu_memory_utilization = var.inference_gpu_memory_utilization
  inference_max_output_tokens      = var.inference_max_output_tokens
  opencode_enabled                 = var.opencode_enabled
  tooling_packages                 = var.tooling_packages
  chotu_release_version            = var.chotu_release_version
}

# ---------------------------------------------------------------------------
# Outputs delegate to whichever module is active.
# ---------------------------------------------------------------------------

output "instance_id" {
  value       = var.cloud_provider == "aws" ? module.aws[0].instance_id : null
  description = "Machine ID of the Chotu machine."
}

output "public_ip" {
  value       = var.cloud_provider == "aws" ? module.aws[0].public_ip : null
  description = "Public IP of the Chotu machine."
}

output "status_url" {
  value       = var.cloud_provider == "aws" ? module.aws[0].status_url : null
  description = "Status page: setup progress and system resources while the machine converges."
}

output "ssh" {
  value       = var.cloud_provider == "aws" ? module.aws[0].ssh : null
  description = "SSH command with the generated key and tunnels."
}

output "ssh_config_snippet" {
  value       = var.cloud_provider == "aws" ? module.aws[0].ssh_config_snippet : null
  description = "Paste into ~/.ssh/config for plain `ssh chotu` with tunnels."
}

output "s3_bucket" {
  value       = var.cloud_provider == "aws" ? module.aws[0].s3_bucket : null
  description = "Workspace bucket in use (created or adopted)."
}
