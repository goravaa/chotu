#!/usr/bin/env bash
#
# Chotu machine init. Runs once as root via cloud-init user_data: writes
# /etc/chotu/config.yaml from terraform variables, then runs the release
# bootstrap, which downloads both daemon binaries and starts them as
# systemd units (status-service first, chotu-setup second).
#
# Note on escaping: this file is rendered by terraform templatefile, so
# $${...} interpolates. Shell variables below deliberately use the $VAR
# form (no braces) to stay literal.

set -euo pipefail

exec >> /var/log/chotu-user-data.log 2>&1

RELEASE_VERSION="${release_version}"
CONFIG_PATH=/etc/chotu/config.yaml

mkdir -p /etc/chotu

cat > $CONFIG_PATH <<CONFIG_EOF
# Generated by terraform (modules/aws). Do not edit by hand: change the
# terraform variables and re-apply instead.
machine:
  instance_type: ${instance_type}
  image_id: ${image_id}
  region: ${region}
  ssh_key_path: .
  use_spot: ${use_spot}
  storage:
    persist: ${persist}
    root_disk_size_gb: ${root_disk_size_gb}
    root_disk_type: ${root_disk_type}
s3:
  enabled: ${s3_enabled}
  bucket_name: ${s3_bucket_name}
  region: ${region}
  sync:
    prefix: ${s3_sync_prefix}
    interval: ${s3_sync_interval}
    exclusions:
%{ for pattern in s3_exclusions }
      - ${pattern}
%{ endfor }
inference:
  runtime: ${inference_runtime}
  model: ${inference_model}
  quantization: ${inference_quantization}
  access: ${inference_access}
  image: ${inference_image}
  port: ${inference_port}
  resources:
    max_model_len: ${inference_max_model_len}
    gpu_memory_utilization: ${inference_gpu_memory_utilization}
    max_output_tokens: ${inference_max_output_tokens}
coding:
  opencode: ${opencode_enabled}
status_page:
  enabled: true
  port: ${status_port}
tooling:
  packages:
%{ for package in tooling_packages }
    - ${package}
%{ endfor }
CONFIG_EOF

curl -fsSL https://raw.githubusercontent.com/goravaa/chotu/$RELEASE_VERSION/bootstrap/bootstrap.sh -o /tmp/chotu-bootstrap.sh
CHOTU_RELEASE_VERSION=$RELEASE_VERSION bash /tmp/chotu-bootstrap.sh
